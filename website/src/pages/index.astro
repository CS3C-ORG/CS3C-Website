---
import Heading from "../components/ui/Heading.astro";
import Section from "../components/ui/Section.astro";
import Text from "../components/ui/Text.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
	<main class="flex min-h-screen flex-col justify-center py-8 text-center">
		<Section spacing="none">
			<Heading level={1} size="display" tone="accent">
				CS3C
			</Heading>
			<Text as="p" size="xl" weight="semibold" class="mt-4">
				Evidence. Engineered.
			</Text>
			<Text tone="muted" class="mt-4">
				This is the foundation of the CS3C knowledge platform.
			</Text>
		</Section>
	</main>
</MainLayout>
