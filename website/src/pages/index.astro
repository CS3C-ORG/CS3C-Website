---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
	<main>
		<h1>CS3C</h1>
		<p class="tagline">Evidence. Engineered.</p>
		<p>This is the foundation of the CS3C knowledge platform.</p>
	</main>
</MainLayout>

<style>
	main {
		display: flex;
		min-height: 100vh;
		padding: 2rem;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		text-align: center;
	}

	h1,
	p {
		margin: 0;
	}

	h1 {
		color: var(--accent);
		font-size: clamp(3rem, 10vw, 6rem);
		font-weight: 600;
		letter-spacing: -0.06em;
	}

	.tagline {
		margin-top: 1rem;
		font-size: clamp(1.25rem, 4vw, 2rem);
		font-weight: 600;
	}

	p:last-child {
		margin-top: 1rem;
		color: var(--muted);
		line-height: 1.6;
	}
</style>
