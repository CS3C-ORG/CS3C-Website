---
import Section from "../components/ui/Section.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
	<main class="flex min-h-screen flex-col justify-center py-8 text-center">
		<Section spacing="none">
			<h1
				class="m-0 text-[clamp(3rem,10vw,6rem)] font-semibold tracking-[-0.06em] text-[var(--accent)]"
			>
				CS3C
			</h1>
			<p class="m-0 mt-4 text-[clamp(1.25rem,4vw,2rem)] font-semibold">
				Evidence. Engineered.
			</p>
			<p class="m-0 mt-4 leading-[1.6] text-[var(--muted)]">
				This is the foundation of the CS3C knowledge platform.
			</p>
		</Section>
	</main>
</MainLayout>
