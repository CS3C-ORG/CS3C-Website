---
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import Button from "../components/ui/Button.astro";
import Logo from "../components/ui/Logo.astro";
import Section from "../components/ui/Section.astro";
import Text from "../components/ui/Text.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
	<div class="flex min-h-screen flex-col">
		<Header />
		<main class="flex flex-1 flex-col justify-center py-8 text-center">
			<Section id="foundation" spacing="none">
				<Logo size="lg" class="justify-center" />
				<Text as="p" size="xl" weight="semibold" class="mt-4">
					Evidence. Engineered.
				</Text>
				<Text tone="muted" class="mt-4">
					This is the foundation of the CS3C knowledge platform.
				</Text>
				<Button href="#foundation" variant="primary" class="mt-8">
					Explore the platform
				</Button>
			</Section>
		</main>
		<Footer />
	</div>
</MainLayout>
