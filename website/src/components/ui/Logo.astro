---
type Size = "sm" | "md" | "lg";

interface Props {
	href?: string;
	size?: Size;
	class?: string;
	id?: string;
	"aria-label"?: string;
}

const {
	href = "/",
	size = "md",
	class: className,
	id,
	"aria-label": ariaLabel = "CS3C home",
} = Astro.props;

const sizeClasses: Record<
	Size,
	{ mark: string; text: string; gap: string }
> = {
	sm: {
		mark: "h-7 w-7",
		text: "text-lg",
		gap: "gap-2",
	},
	md: {
		mark: "h-9 w-9",
		text: "text-xl",
		gap: "gap-3",
	},
	lg: {
		mark: "h-11 w-11",
		text: "text-2xl",
		gap: "gap-3",
	},
};

const classes = [
	"inline-flex items-center rounded-sm text-[var(--foreground)] no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--background)]",
	sizeClasses[size].gap,
	className,
]
	.filter(Boolean)
	.join(" ");
---

<a href={href} id={id} class={classes} aria-label={ariaLabel}>
	<span
		aria-hidden="true"
		class:list={["relative shrink-0", sizeClasses[size].mark]}
	>
		<span
			class="absolute left-0 top-0 h-[62%] w-[62%] rounded-[0.18em] bg-[var(--accent)]"
		></span>
		<span
			class="absolute right-0 top-[19%] h-[62%] w-[62%] rounded-[0.18em] bg-[var(--accent)] opacity-75"
		></span>
		<span
			class="absolute bottom-0 left-[19%] h-[62%] w-[62%] rounded-[0.18em] bg-[var(--accent)] opacity-50"
		></span>
	</span>
	<span
		class:list={[
			"font-semibold tracking-[-0.04em]",
			sizeClasses[size].text,
		]}
	>
		CS3C
	</span>
</a>
