---
type Size = "sm" | "md" | "lg";

interface Props {
	href?: string;
	size?: Size;
	class?: string;
	id?: string;
	"aria-label"?: string;
}

const {
	href = "/",
	size = "md",
	class: className,
	id,
	"aria-label": ariaLabel = "CS3C home",
} = Astro.props;

const sizeClasses: Record<
	Size,
	{ mark: string; text: string; gap: string }
> = {
	sm: {
		mark: "h-7 w-7",
		text: "text-lg",
		gap: "gap-2",
	},
	md: {
		mark: "h-9 w-9",
		text: "text-xl",
		gap: "gap-3",
	},
	lg: {
		mark: "h-11 w-11",
		text: "text-2xl",
		gap: "gap-3",
	},
};

const classes = [
	"inline-flex items-center rounded-sm text-[var(--foreground)] no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--background)]",
	sizeClasses[size].gap,
	className,
]
	.filter(Boolean)
	.join(" ");
---

<a href={href} id={id} class={classes} aria-label={ariaLabel}>
	<span
		aria-hidden="true"
		class:list={["shrink-0", sizeClasses[size].mark]}
	>
		<svg
			viewBox="0 0 40 32"
			preserveAspectRatio="xMinYMid meet"
			focusable="false"
			class="block h-full w-full"
		>
			<rect x="0" y="2" width="40" height="4" rx="1.5" fill="#14532d"></rect>
			<rect x="0" y="8" width="32" height="4" rx="1.5" fill="#166534"></rect>
			<rect x="0" y="14" width="24" height="4" rx="1.5" fill="#4a8f5b"></rect>
			<rect x="0" y="20" width="16" height="4" rx="1.5" fill="#7dbd8e"></rect>
			<rect x="0" y="26" width="8" height="4" rx="1.5" fill="#b7dbbf"></rect>
		</svg>
	</span>
	<span
		class:list={[
			"font-semibold tracking-[-0.04em]",
			sizeClasses[size].text,
		]}
	>
		CS3C
	</span>
</a>
